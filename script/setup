#!/bin/sh
set -e
[ -z "${DEBUG}" ] || set -x

BASEDIR="$(dirname "$0")/.."
cd "${BASEDIR}"

PYENV_ROOT="${PYENV_ROOT:-${HOME}/.pyenv}"
export PATH="${PYENV_ROOT}/bin:${HOME}/.local/bin:${PATH}"

uv_bin="$(command -v uv)"
if [ -z "$uv_bin" ]; then
    echo "uv not found, installing..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="${PYENV_ROOT}/bin:${HOME}/.local/bin:${PATH}"
    uv_bin="$(command -v uv)"
fi

python_version=$(sed 's/#.*//' .python-version 2>/dev/null | head -n1 | tr -d ' \t\r\n' || true)
if [ -z "$python_version" ]; then
    echo "Missing or empty .python-version in ${BASEDIR}" >&2
    exit 1
fi

if ! command -v pyenv >/dev/null 2>&1; then
    if [ -x "${PYENV_ROOT}/bin/pyenv" ]; then
        export PATH="${PYENV_ROOT}/bin:${PATH}"
    else
        echo "pyenv not found. Install: https://github.com/pyenv/pyenv#installation" >&2
        exit 1
    fi
fi

eval "$(pyenv init -)"
pyenv install -s "$python_version"
py_cmd="$(pyenv which python)"

if [ -z "$py_cmd" ] || [ ! -x "$py_cmd" ]; then
    echo "Could not resolve Python ${python_version} for ${BASEDIR} (.python-version). Try: pyenv install ${python_version}" >&2
    exit 1
fi

# mysqlclient has no Linux wheels; building it needs MariaDB headers AND Python.h for this interpreter.
sync_args=""
if [ "$(uname -s)" = "Linux" ]; then
    has_mariadb_pc=0
    if pkg-config --exists mariadb 2>/dev/null \
        || pkg-config --exists libmariadb 2>/dev/null \
        || pkg-config --exists mysqlclient 2>/dev/null
    then
        has_mariadb_pc=1
    fi

    has_python_h=0
    inc="$("$py_cmd" -c 'import sysconfig; print(sysconfig.get_path("include"))' 2>/dev/null)" || true
    if [ -n "$inc" ] && [ -f "$inc/Python.h" ]; then
        has_python_h=1
    fi

    if [ "$has_mariadb_pc" != 1 ] || [ "$has_python_h" != 1 ]; then
        sync_args="--no-install-package mysqlclient"
        echo "Note: skipping mysqlclient (C extension). MySqlHook will use PyMySQL or mysql-connector-python."
        if [ "$has_mariadb_pc" != 1 ]; then
            echo "  For native mysqlclient also install: sudo apt install libmariadb-dev pkg-config build-essential"
        fi
        if [ "$has_python_h" != 1 ]; then
            echo "  This pyenv Python is missing headers; reinstall with: PYTHON_CONFIGURE_OPTS='--enable-shared' pyenv install -f ${python_version}"
            echo "  (or install a matching OS python3.x-dev only if you stop using pyenv for this project)"
        fi
    fi
fi

"$uv_bin" sync --python "$py_cmd" $sync_args

# Wire git hooks that keep .git-commit.env in sync with HEAD. This file is
# forwarded into every Airflow service by docker-compose so the ML
# build_ml_training_snapshots task can use GIT_COMMIT as its pipeline_version
# cache-key. core.hooksPath is repo-local, so this never bleeds out.
if [ -d .githooks ] && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git config core.hooksPath .githooks
    # Bootstrap once so .git-commit.env exists before any git op fires a hook.
    if [ -x .githooks/_write-git-commit.sh ]; then
        ./.githooks/_write-git-commit.sh
    fi
fi

# docker compose up airflow-init
