#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Import track grouping mappings from CSV into nascar.track_types and nascar.tracks_track_types.

Usage:
  ./script/import-track-groupings [csv-file-path]

Defaults:
  csv-file-path: <repo>/data/nascar_tracks_groupings.csv
  database:      ${DATABASE_NAME:-nascar}
  user:          ${DATABASE_DUMP_USER:-root}
  password:      ${DATABASE_DUMP_PASSWORD:-${DATABASE_ROOT_PASSWORD:-password}}

Expected CSV header:
  track_name,accupredict_track_grouping,nascar_shape_grouping,nascar_size_grouping
EOF
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

CSV_PATH="${1:-$ROOT/data/nascar_tracks_groupings.csv}"
DB_NAME="${DATABASE_NAME:-nascar}"
DB_USER="${DATABASE_DUMP_USER:-root}"
DB_PASSWORD="${DATABASE_DUMP_PASSWORD:-${DATABASE_ROOT_PASSWORD:-password}}"

if [[ ! -f "$CSV_PATH" ]]; then
  echo "CSV file does not exist: $CSV_PATH" >&2
  exit 1
fi
if [[ ! -r "$CSV_PATH" ]]; then
  echo "CSV file is not readable: $CSV_PATH" >&2
  exit 1
fi

if [[ ! "$DB_NAME" =~ ^[A-Za-z0-9_]+$ ]]; then
  echo "Invalid DATABASE_NAME '$DB_NAME'." >&2
  exit 1
fi

SQL_FILE="$(mktemp)"
trap 'rm -f "$SQL_FILE"' EXIT

python3 - "$CSV_PATH" > "$SQL_FILE" <<'PY'
import csv
import sys

csv_path = sys.argv[1]

# FRCS CSV names -> nascar.tracks.name when the schedule importer uses a different label.
TRACK_NAME_ALIASES = {
    "Chicago Street Circuit": "Chicago Street Race",
    "Charlotte Motor Speedway Road Course": "Charlotte Motor Speedway (Road Course)",
    "Autodromo Hermanos Rodriguez": "Autódromo Hermanos Rodríguez",
}

required = [
    "track_name",
    "accupredict_track_grouping",
    "nascar_shape_grouping",
    "nascar_size_grouping",
]

rows = []
with open(csv_path, newline="", encoding="utf-8") as f:
    reader = csv.DictReader(f)
    if reader.fieldnames is None:
        raise SystemExit("CSV is empty or missing header.")
    missing = [c for c in required if c not in reader.fieldnames]
    if missing:
        raise SystemExit(f"CSV missing required columns: {', '.join(missing)}")

    for row in reader:
        track_name = (row["track_name"] or "").strip()
        track_name = TRACK_NAME_ALIASES.get(track_name, track_name)
        if not track_name:
            continue
        for col in required[1:]:
            type_name = (row[col] or "").strip()
            if type_name:
                rows.append((track_name, type_name))

if not rows:
    raise SystemExit("No track/grouping rows found in CSV.")

def esc(v: str) -> str:
    return v.replace("\\", "\\\\").replace("'", "''")

print("START TRANSACTION;")
print(
    "CREATE TEMPORARY TABLE tmp_track_groupings ("
    " track_name VARCHAR(255) NOT NULL,"
    " track_type_name VARCHAR(255) NOT NULL,"
    " PRIMARY KEY (track_name, track_type_name)"
    ") ENGINE=InnoDB;"
)

batch = []
for track_name, type_name in rows:
    batch.append(f"('{esc(track_name)}','{esc(type_name)}')")
    if len(batch) >= 500:
        print(
            "INSERT IGNORE INTO tmp_track_groupings (track_name, track_type_name) VALUES "
            + ", ".join(batch)
            + ";"
        )
        batch = []
if batch:
    print(
        "INSERT IGNORE INTO tmp_track_groupings (track_name, track_type_name) VALUES "
        + ", ".join(batch)
        + ";"
    )

# Restore soft-deleted track types when names match incoming data.
print(
    "UPDATE track_types tt "
    "JOIN (SELECT DISTINCT track_type_name FROM tmp_track_groupings) src "
    "  ON src.track_type_name = tt.name "
    "SET tt.deleted_at = NULL "
    "WHERE tt.deleted_at IS NOT NULL;"
)

# Insert missing active track types.
print(
    "INSERT INTO track_types (name, description) "
    "SELECT src.track_type_name, "
    "       CONCAT('Imported from track groupings CSV: ', src.track_type_name) "
    "FROM (SELECT DISTINCT track_type_name FROM tmp_track_groupings) src "
    "LEFT JOIN track_types tt "
    "  ON tt.name = src.track_type_name AND tt.deleted_at IS NULL "
    "WHERE tt.id IS NULL;"
)

# Report any track names from CSV that do not exist in tracks.
print("SELECT 'UNMATCHED_TRACKS' AS section, src.track_name AS value")
print("FROM (SELECT DISTINCT track_name FROM tmp_track_groupings) src")
print("LEFT JOIN tracks t ON t.name = src.track_name AND t.deleted_at IS NULL")
print("WHERE t.id IS NULL")
print("ORDER BY src.track_name;")

# Restore soft-deleted bridge rows if they already exist.
print(
    "UPDATE tracks_track_types ttt "
    "JOIN tracks t ON t.id = ttt.track_id AND t.deleted_at IS NULL "
    "JOIN track_types tt ON tt.id = ttt.track_type_id AND tt.deleted_at IS NULL "
    "JOIN tmp_track_groupings src "
    "  ON src.track_name = t.name AND src.track_type_name = tt.name "
    "SET ttt.deleted_at = NULL "
    "WHERE ttt.deleted_at IS NOT NULL;"
)

# Insert missing bridge rows.
print(
    "INSERT IGNORE INTO tracks_track_types (track_id, track_type_id) "
    "SELECT t.id, tt.id "
    "FROM tmp_track_groupings src "
    "JOIN tracks t ON t.name = src.track_name AND t.deleted_at IS NULL "
    "JOIN track_types tt ON tt.name = src.track_type_name AND tt.deleted_at IS NULL;"
)

print("COMMIT;")
print("SELECT 'IMPORTED_TRACK_TYPE_COUNT' AS metric, COUNT(*) AS value FROM track_types WHERE deleted_at IS NULL;")
print("SELECT 'IMPORTED_TRACK_TRACK_TYPE_COUNT' AS metric, COUNT(*) AS value FROM tracks_track_types WHERE deleted_at IS NULL;")
PY

docker compose exec -T \
  -e MYSQL_PWD="$DB_PASSWORD" \
  mariadb \
  mariadb -u"$DB_USER" -D"$DB_NAME" < "$SQL_FILE"

echo "Import complete from CSV: $CSV_PATH"
