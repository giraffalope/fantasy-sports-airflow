#!/usr/bin/env sh
# Run mypy on project Python trees (production code; tests are Ruff-only).
set -e
[ -z "${DEBUG}" ] || set -x

BASEDIR="$(dirname "$0")/.."
cd "${BASEDIR}"

case "${1:-}" in
  --help | -h)
    printf '%s\n' \
      "Usage: ./script/typecheck [mypy-args]" \
      "" \
      "Runs \`mypy\` on dags/, include/, and airflow_utils/ (see pyproject.toml [tool.mypy])." \
      "Requires uv and dev deps from script/setup. Examples:" \
      "  ./script/typecheck" \
      "  ./script/typecheck --show-error-codes dags/nascar/cup/importer.py"
    exit 0
    ;;
esac

uv_bin="$(command -v uv)"
if [ -z "$uv_bin" ]; then
  echo "uv not found; install from https://docs.astral.sh/uv/ or run script/setup" >&2
  exit 1
fi

exec "$uv_bin" run mypy "$@"
