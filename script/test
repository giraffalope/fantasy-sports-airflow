#!/usr/bin/env bash
# Build the test image and run pytest inside Docker.
#   ./script/test              — unit + integration (default)
#   ./script/test --unit       — tests/unit only
#   ./script/test --integration — tests/integration only
#   ./script/test --regression — run regression suite only
#   ./script/test --unit --integration — same as default
# Options must come first; remaining args are passed to pytest (e.g. --unit -k schedule).
set -euo pipefail

usage() {
  cat <<'EOF'
Build the test image and run pytest inside Docker.

  ./script/test                  Run unit and integration tests (default)
  ./script/test --unit           Run tests/unit only
  ./script/test --integration    Run tests/integration only
  ./script/test --regression     Run regression tests only
  ./script/test --unit --integration   Same as default (both)

Place --unit / --integration before any pytest options, e.g.:
  ./script/test --unit -k schedule

Coverage is enabled via pyproject.toml (fails under 30% line coverage). To skip:
  ./script/test --no-cov

Environment:
  UNIT_TESTS_IMAGE   Docker image tag (default: fantasy-sports-airflow-unit-tests:latest)
EOF
}

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

IMAGE_NAME="${UNIT_TESTS_IMAGE:-fantasy-sports-airflow-unit-tests:latest}"

run_unit=false
run_integration=false
run_regression=false

while (($#)); do
  case "$1" in
    --unit)
      run_unit=true
      shift
      ;;
    --integration)
      run_integration=true
      shift
      ;;
    --regression)
      run_regression=true
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

if ! $run_unit && ! $run_integration; then
  run_unit=true
  run_integration=true
fi

paths=()
if $run_regression; then
  paths+=(
    tests/integration/test_cup_importer_regression_suite.py
    tests/integration/test_cup_importer_team_regression_db_runtime.py
  )
else
$run_unit && paths+=(tests/unit)
$run_integration && paths+=(tests/integration)
fi

if [[ ${#paths[@]} -eq 0 ]]; then
  echo "No test paths selected." >&2
  exit 1
fi

docker build -f Dockerfile.unit-tests -t "$IMAGE_NAME" "$ROOT"

docker_args=(--rm)
if $run_integration || $run_regression; then
  mariadb_container_name="${MARIADB_CONTAINER_NAME:-mariadb}"
  if $run_regression; then
    # Keep regression DB isolated from any active dev environment.
    compose_project="${REGRESSION_COMPOSE_PROJECT_NAME:-regression-fantasy-sports-airflow}"
    db_port="${REGRESSION_DATABASE_PORT:-3307}"
    mariadb_container_name="${REGRESSION_MARIADB_CONTAINER_NAME:-regression-mariadb}"
    COMPOSE_PROJECT_NAME="$compose_project" \
      DATABASE_PORT="$db_port" \
      MARIADB_CONTAINER_NAME="$mariadb_container_name" \
      docker compose -p "$compose_project" up -d mariadb >/dev/null
  else
    db_port="${DATABASE_PORT:-3306}"
    docker compose up -d mariadb >/dev/null
  fi
  # Wait for MariaDB readiness to avoid transient handshake failures.
  for _ in $(seq 1 60); do
    health="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$mariadb_container_name" 2>/dev/null || true)"
    if [[ "$health" == "healthy" || "$health" == "running" ]]; then
      if docker exec "$mariadb_container_name" mariadb-admin ping -u"${DATABASE_USER:-username}" -p"${DATABASE_PASSWORD:-password}" --silent >/dev/null 2>&1; then
        break
      fi
    fi
    sleep 2
  done
  default_conn="mariadb://username:password@host.docker.internal:${db_port}/nascar?charset=utf8mb4&collation=utf8mb4_uca1400_ai_ci"
  docker_args+=(
    --add-host=host.docker.internal:host-gateway
    -e "AIRFLOW_CONN_NASCAR_CONN=${AIRFLOW_CONN_NASCAR_CONN:-$default_conn}"
    -e "AIRFLOW_CONN_MARIADB_CONN=${AIRFLOW_CONN_MARIADB_CONN:-$default_conn}"
  )
  if $run_regression; then
    regression_scraper_root="${ROOT}/scraper-data-regression/nascar"
    rm -rf "${regression_scraper_root}"
    mkdir -p "${ROOT}/scraper-data-regression"
    cp -R "${ROOT}/scraper-data/nascar" "${regression_scraper_root}"
    # Match dev runtime path while keeping regression data isolated.
    docker_args+=(
      -v "${regression_scraper_root}:/home/airflow/scraper/nascar"
    )
  fi
fi

exec docker run "${docker_args[@]}" "$IMAGE_NAME" python -m pytest "${paths[@]}" "$@"
