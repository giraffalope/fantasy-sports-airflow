# Copy to .env and adjust for local docker compose.

AIRFLOW_UID=1000
AIRFLOW__CORE__LOAD_EXAMPLES=False

# Register backfill.* Cup DAGs in the Airflow UI (1/true/yes/on). Default off.
FS_ENABLE_BACKFILL_DAGS=0

# MariaDB (Compose service "mariadb") — used by script/db-migrate, script/db-query, db-backup, db-restore
# DATABASE_NAME=nascar
# DATABASE_USER=username
# DATABASE_PASSWORD=password
# DATABASE_ROOT_PASSWORD=password
# MARIADB_SERVICE=mariadb
# DATABASE_MIGRATE_USER=username
# DATABASE_MIGRATE_PASSWORD=password
