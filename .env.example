# Copy to .env and adjust for local Docker Compose.
#
# Compose interpolates these values into docker-compose.yaml. Airflow task code
# (FS_*, NASCAR_*) reads the process environment inside workers/schedulers — add
# any FS_* / NASCAR_* / AIRFLOW_* overrides you need to the `environment:` block
# in docker-compose.yaml (or add `env_file: .env` under x-airflow-common) so
# containers see them.

# -----------------------------------------------------------------------------
# Docker Compose / Airflow platform
# -----------------------------------------------------------------------------

# User ID for Airflow containers (match host uid; see compose airflow-init warning).
AIRFLOW_UID=1000

# Custom Airflow image name (default: fantasy-sports-airflow:latest).
# AIRFLOW_IMAGE_NAME=fantasy-sports-airflow:latest

# Repo root for volume mounts (default: .).
# AIRFLOW_PROJ_DIR=.

# Host bind mount for scrape output → /home/airflow/scraper/nascar/…
# AIRFLOW_SCRAPER_DATA_DIR=./scraper-data

# Host bind mount for DFS CSV drops → /home/airflow/dfs
# AIRFLOW_DFS_DATA_DIR=./dfs-data

# Inside-container DFS root if not using the default mount path.
# AIRFLOW_DFS_ROOT=/home/airflow/dfs

# Airflow home (SQL path fallback in importer).
# AIRFLOW_HOME=/opt/airflow

# Core Airflow settings (also set in compose; override here if needed).
AIRFLOW__CORE__LOAD_EXAMPLES=False

# Scheduling and container OS time (all Airflow services use UTC by default in compose).
# AIRFLOW__CORE__DEFAULT_TIMEZONE=utc
# TZ=UTC

# JWT for Airflow 3 API (change in production).
# AIRFLOW__API_AUTH__JWT_SECRET=airflow_jwt_secret_change_me
# AIRFLOW__API_AUTH__JWT_ISSUER=airflow

# Admin user created by airflow-init.
# _AIRFLOW_WWW_USER_USERNAME=airflow
# _AIRFLOW_WWW_USER_PASSWORD=airflow

# Extra pip packages on container start (dev only; prefer baking into the image).
# _PIP_ADDITIONAL_REQUIREMENTS=

# MariaDB image build (Compose service mariadb).
# FANTASY_SPORTS_DB_BUILD_CONTEXT=../fantasy-sports-db
# FANTASY_SPORTS_DB_IMAGE=fantasy-sports-db:latest
# MARIADB_CONTAINER_NAME=mariadb

# -----------------------------------------------------------------------------
# MariaDB credentials (Compose mariadb + host scripts)
# -----------------------------------------------------------------------------

# DATABASE_NAME=nascar
# DATABASE_USER=username
# DATABASE_PASSWORD=password
# DATABASE_ROOT_PASSWORD=password
# DATABASE_PORT=3306

# script/db-migrate, script/db-query (Compose exec).
# MARIADB_SERVICE=mariadb
# DATABASE_MIGRATE_USER=username
# DATABASE_MIGRATE_PASSWORD=password

# script/db-backup, script/db-restore, script/import-track-groupings.
# DATABASE_DUMP_USER=root
# DATABASE_DUMP_PASSWORD=
# DATABASE_RESTORE_USER=root
# DATABASE_RESTORE_PASSWORD=

# Sibling fantasy-sports-db path for ./script/db-backup --sync.
# FANTASY_SPORTS_DB_PATH=../fantasy-sports-db

# Airflow MySQL connections (must match DATABASE_* / mariadb service).
# Set in compose by default; override for non-default credentials.
# AIRFLOW_CONN_NASCAR_CONN=mariadb://username:password@mariadb:3306/nascar?charset=utf8mb4&collation=utf8mb4_uca1400_ai_ci
# AIRFLOW_CONN_MARIADB_CONN=mariadb://username:password@mariadb:3306/nascar?charset=utf8mb4&collation=utf8mb4_uca1400_ai_ci

# -----------------------------------------------------------------------------
# DAG registration and pipelines
# -----------------------------------------------------------------------------

# Register backfill.* Cup DAGs in the UI (1/true/yes/on). Default off.
FS_ENABLE_BACKFILL_DAGS=0

# Importer SQL root: directory that contains nascar/cup/scraper/sql/…
# NASCAR_AIRFLOW_SQL_ROOT=

# Lineage stamped on ML snapshots. `build_ml_training_snapshots` reads
#   pipeline_version = FS_PIPELINE_VERSION or GIT_COMMIT
# and uses it as the cache-key for the "skip when up-to-date" gate on train
# snapshots: every finished week whose stored `source_pipeline_version` already
# matches is skipped (no DELETE/INSERT cycle, no cascade).
#
# GIT_COMMIT is auto-populated by the hooks in .githooks/ (installed by
# script/setup via core.hooksPath) into .git-commit.env, which docker-compose
# forwards into every Airflow service via the env_file: block on the
# &airflow-common anchor. So you don't need to set GIT_COMMIT here unless you
# want to pin a specific SHA — the hooks will keep .git-commit.env in sync
# with HEAD on every git pull / commit / checkout / rebase.
#
# Set FS_PIPELINE_VERSION below only when you want an explicit semantic
# version (e.g. "2026.05.27-feature-X") to win over the auto-populated SHA.
# Per-week force-rebuilds are controlled by FS_ML_REBUILD_WEEK_IDS (see the
# ML section below).
# FS_PIPELINE_VERSION=
# GIT_COMMIT=  # auto-populated; uncomment only to pin manually

# -----------------------------------------------------------------------------
# nascar.cup.aggregate
# -----------------------------------------------------------------------------

# Rebuild all weeks on each aggregate run (1/true/yes/on). Default 0.
# FS_AGG_REBUILD_ALL_WEEKS=0

# Extra week_ids to load (comma-separated), merged into the week list.
# FS_AGG_REBUILD_WEEK_IDS=

# -----------------------------------------------------------------------------
# nascar.cup.machine_learning.models (train / predict)
# -----------------------------------------------------------------------------

# On-disk XGBoost artifacts (default /opt/airflow/artifacts/ml).
# FS_ML_ARTIFACT_ROOT=/opt/airflow/artifacts/ml

# Chronological holdout weeks during training (default 1).
# FS_ML_HOLDOUT_WEEKS=1

# Min distinct finished weeks across a (series_id, track_type_id) cohort
# before that cohort is trained (default 2). Cohorts below this threshold
# are skipped with `insufficient_cohort_weeks` and contribute nothing to
# the blend until they meet it.
# FS_ML_MIN_COHORT_WEEKS=2

# How to weight per-cohort predictions for the current track's
# track_type_id set: inverse_mae (default), sample_count, equal, or
# spearman. inverse_mae falls back to equal when any contributor lacks
# a recorded holdout MAE; spearman (Phase E5) reads dfs_points_spearman
# from ml_model_evaluations, weights by max(0, spearman), and falls back
# to equal when any contributor lacks a recorded Spearman or when every
# Spearman is <= 0.
# FS_ML_BLEND_WEIGHTS=inverse_mae

# Phase A2 chronological dev-slice weeks used by RandomizedSearchCV
# scoring and Phase A4 early-stopping watch (default 1). Cohorts with
# fewer than 4 distinct weeks fall back to the legacy (train, holdout)
# split without a dev slice.
# FS_ML_DEV_WEEKS=1

# Phase B2: when 1/true/yes, build_feature_matrix raises on residual
# non-finite cells instead of zero-filling. Training tasks opt in; the
# predict path always runs non-strict.
# FS_ML_STRICT_FEATURES=0

# Phase D2: switch the primary-target objective to rank:pairwise with
# week_id as the qid group key (default off). Mutually exclusive with
# the two-stage DNF compose — when DNF labels are present in the cohort
# frame the trainer logs a warning and falls back to reg:absoluteerror.
# Flip on only after a champion/challenger cycle validates the score
# change downstream.
# FS_ML_PRIMARY_RANK_OBJECTIVE=0

# Phase E1 / E2: per-driver Monte Carlo interval source. conformal
# (default) pulls (q10, q90) from ml_models.holdout_residual_quantiles
# and sizes σ ≈ (q90 - q10) / 2 per target. global_mae is the legacy
# σ-derived-from-MAE rollback. quantile is reserved for the v3
# quantile-regression heads and silently falls back to conformal.
# FS_ML_INTERVAL_METHOD=conformal

# Extra finished week_ids for snapshot build (comma-separated).
# FS_ML_REBUILD_WEEK_IDS=

# XGBoost RandomizedSearchCV iterations (default 15, lowered from 25 in the
# Phase-1 OOM mitigation for the 12 GB / 4-core worker profile). With
# FS_ML_TUNE_CV_SPLITS=3 the worst-case CV fit count per target is 45.
# FS_ML_TUNE_N_ITER=15

# TimeSeriesSplit n_splits for tuning (default 3, lowered from 4). Cohorts
# below ``2 * FS_ML_TUNE_CV_SPLITS`` distinct weeks route through the small-
# cohort Boruta path (``FS_ML_BORUTA_SMALL_COHORT_MAX_ITER``).
# FS_ML_TUNE_CV_SPLITS=3

# Skip hyperparameter search; use DEFAULT_PARAMS (1/true/yes).
# FS_ML_TUNE_DISABLE=0

# -----------------------------------------------------------------------------
# Memory tuning for ML training (12 GB / 4-core worker profile)
# -----------------------------------------------------------------------------
#
# XGBoost ``tree_method='hist'`` and BorutaPy together drive the peak resident
# memory inside ``train_models_if_needed_task``. The knobs in this section
# bound that peak so a single cohort fit stays under ~6-8 GB on a 4-core
# worker. See docs/nascar/cup.machine_learning.models.md "Memory tuning" for
# the full pressure-release ordering (env caps -> float32 matrix -> per-target
# gc -> Boruta knobs -> host swap as last resort).

# OpenMP / BLAS thread caps (default 2). XGBoost ``tree_method='hist'``
# allocates per-thread histogram buffers; capping from physical-core count
# (4) -> 2 roughly halves the per-fit peak with no measurable quality
# impact on the cohort sizes we hit. ``MKL`` and ``OPENBLAS`` mirror the
# same ceiling for numpy.
# OMP_NUM_THREADS=2
# MKL_NUM_THREADS=2
# OPENBLAS_NUM_THREADS=2

# Boruta iteration cap (default 30, lowered from the legacy hard-coded 50).
# Boruta's shadow-feature matrix is a 2x copy of the cohort feature matrix
# and it refits the booster ``max_iter`` times, so each iteration shaved
# directly reduces wall time and (transitively) peak memory.
# FS_ML_BORUTA_MAX_ITER=30

# Boruta iteration cap on small cohorts (default 10). A cohort is "small"
# when its distinct week count is below ``2 * FS_ML_TUNE_CV_SPLITS``.
# FS_ML_BORUTA_SMALL_COHORT_MAX_ITER=10

# XGBoost ``n_jobs`` (default 2). Applied to the Boruta inner estimator,
# the RandomizedSearchCV base estimator, and the final early-stopping fit.
# Belt-and-suspenders with ``OMP_NUM_THREADS=2``; drop to ``1`` if a
# cohort still spikes after Phase 1+2+3 mitigations land.
# FS_ML_XGB_N_JOBS=2

# -----------------------------------------------------------------------------
# GPU acceleration for ML training (optional)
# -----------------------------------------------------------------------------
#
# Routes the XGBoost cohort training (``RandomizedSearchCV`` + final fit +
# Boruta inner estimator) through CUDA. Predict / Monte Carlo are CPU-only and
# ignore this knob. See docs/nascar/cup.machine_learning.models.md "GPU
# acceleration" for prerequisites, caveats, and the failure-mode quick
# reference.
#
# Host prerequisites (one-time, outside compose):
#   1. Install ``nvidia-container-toolkit`` from NVIDIA's apt repo (not the
#      distro one — ``apt install nvidia-container-toolkit``).
#   2. Register the runtime: ``sudo nvidia-ctk runtime configure
#      --runtime=docker && sudo systemctl restart docker``.
#   3. Verify with ``docker run --rm --gpus all
#      nvidia/cuda:12.4.0-base-ubuntu22.04 nvidia-smi``.
#
# Valid values:
#   cpu      Legacy CPU ``tree_method='hist'`` (default; safe everywhere).
#   cuda     First available GPU.
#   cuda:N   Specific GPU index when multiple are visible.
#
# Caveats:
#   - Small cohorts (≲ 50k rows) often run *slower* on GPU because of
#     per-fit host→device transfer overhead. Boruta is the worst case:
#     it refits the inner estimator up to ``max_iter`` times on a 2×
#     shadow matrix and pays the transfer cost every iteration.
#   - One CUDA context (~400 MB – 1 GB VRAM) per cohort isolation
#     subprocess. With ``FS_ML_TRAIN_COHORT_ISOLATION=1`` the contexts
#     are sequential (one cohort at a time) so 8 GB VRAM is sufficient,
#     but raising worker concurrency above 1 will OOM the GPU long
#     before the training run finishes.
#   - Recent OOMs on this DAG have been *host* RAM, not GPU. GPU does
#     not relieve host-RAM pressure (Boruta's shadow matrix, the dense
#     feature matrix, and the Python parent all still live in host
#     RAM). Pull the levers in "Memory tuning" first.
# FS_ML_XGB_DEVICE=cpu

# -----------------------------------------------------------------------------
# Cross-task / per-cohort memory isolation (heap-accumulation OOM fix)
# -----------------------------------------------------------------------------
#
# The Phase 1-4 caps above shrink per-task peak; the knobs below stop the
# heap from accumulating across tasks (the actual OOM cause observed on
# the 12 GB worker). See docs/nascar/cup.machine_learning.models.md
# "Memory tuning" -> "What if it still OOMs?" for the diagnostic story.

# Recycle the Celery prefork worker child after every task (default 1).
# Forces a clean glibc heap between tasks; standard Celery memory-leak
# workaround. Per-task cost is one fork() (milliseconds). Set higher
# only if you can prove the tasks don't accumulate heap arenas.
# AIRFLOW__CELERY__WORKER_MAX_TASKS_PER_CHILD=1

# Process-isolate each ML training cohort via multiprocessing spawn
# (default 1). When 1, ``train_models_if_needed_task`` runs every cohort's
# ``load_training_frame + _train_cohort`` in a child process so the heavy
# working set (Boruta shadow matrix, XGBoost models, feature dicts) is
# returned to the OS on child exit. Set to 0 to use the legacy in-process
# path for tests / local debugging.
# FS_ML_TRAIN_COHORT_ISOLATION=1

# Cap the per-cohort training horizon at the most-recent N distinct weeks
# (unset = all available history). Applied as a SQL window subselect in
# ``load_training_frame`` so the row count drops proportionally. Flip on
# without a redeploy when a future cohort grows unexpectedly large.
# FS_ML_MAX_TRAIN_WEEKS=

# -----------------------------------------------------------------------------
# nascar.cup.machine_learning.models.backtest
# -----------------------------------------------------------------------------

# Max recent finished weeks in walk-forward eval loop (default 12).
# FS_ML_BACKTEST_MAX_WEEKS=12

# Cap the **training-frame SQL load** at the most-recent N distinct weeks
# (default 64). Applied as a window subselect in ``load_training_frame``
# so the row count drops proportionally at the DB layer — critical
# because the backtest loads the whole series (not a single cohort) and
# unbounded loads grow with every new Cup week. Lower this if the worker
# OOMs on big seasons; the default is sized to cover 12 eval weeks plus
# ~1 year of train history per eval week without exceeding the 8 GiB
# worker cgroup limit. Distinct from FS_ML_BACKTEST_MAX_WEEKS, which
# bounds wall-clock (outer eval loop) but does nothing to memory.
# FS_ML_BACKTEST_LOAD_WEEKS=64

# (FS_ML_HOLDOUT_WEEKS also applies inside backtest in-memory training.)

# -----------------------------------------------------------------------------
# nascar.cup.machine_learning.models.monte_carlo
# -----------------------------------------------------------------------------

# Draws per driver per Monte Carlo batch (default 10000, hard minimum 1000).
# Lowering to 1000-2000 trades portfolio percentile fidelity for ~10x faster
# MC + lineup runs and is useful for backfills or developer loops.
# FS_MC_N_SIMULATIONS=10000

# Override the numpy.random.Generator seed; defaults to a snapshot-derived value.
# FS_MC_RANDOM_SEED=

# Root directory for Monte Carlo joint-samples sidecar files
# (.npz with arrays joint_dfs_points, car_driver_ids, meta). Read by the
# lineup task to score candidate lineups against the true coupled
# distribution; the parent directory must be writable by the worker UID.
# Compose mounts ${AIRFLOW_PROJ_DIR}/artifacts -> /opt/airflow/artifacts so
# the default is identical between worker container and host.
# FS_MC_ARTIFACT_ROOT=/opt/airflow/artifacts/mc

# -----------------------------------------------------------------------------
# nascar.cup.dfs.lineup_generator
# -----------------------------------------------------------------------------

# FS_DK_LINEUP_SIZE=6
# FS_DK_SALARY_CAP=50000
# FS_DK_TOP_K=40
# FS_DK_MIN_DIFF_DOUBLE_UP=2
# FS_DK_MIN_DIFF_HIGH_RISK_REWARD=1

# Monte Carlo summary column used to ORDER the CP-SAT candidate pool. The
# final per-lineup objective is set per strategy via the JOINT metrics
# below; this knob only influences which lineups make the candidate pool.
# Valid values: mean, p05, p50, p95, min, max (default p50).
# FS_DK_MC_OBJECTIVE=p50

# Portfolio selection (per DraftKings strategy). Objective metrics are
# computed against the joint MC draw matrix so they capture rank-coupling
# between drivers in the same simulation iteration. Valid objective
# tokens: joint_p10, joint_p50, joint_p90, joint_mean, joint_sharpe.
#
# Write-time exposure defaults are strategy-specific
# (DOUBLE_UP=0.70, HIGH_RISK_REWARD=0.40); read-time diversification
# is applied by the `nascar.dfs_lineups` stored procedure (see
# docs/nascar/cup.dfs.lineup_generator.md).
#
# DOUBLE_UP (cash / 50-50): high-floor objective.
# FS_DK_DOUBLE_UP_OBJECTIVE=joint_p10
# FS_DK_DOUBLE_UP_EXPOSURE_CAP=0.70
#
# HIGH_RISK_REWARD (GPP / tournament): high-ceiling objective.
# FS_DK_HIGH_RISK_REWARD_OBJECTIVE=joint_p90
# FS_DK_HIGH_RISK_REWARD_EXPOSURE_CAP=0.40
#
# Candidate pool depth: top_k * multiplier CP-SAT solves per strategy are
# evaluated, then the greedy diversifier picks top_k under the exposure
# cap. Higher = more diversity headroom; lower = faster but starves the
# selector. Default 5 with top_k=40 puts the pool at 200 lineups per strategy.
# FS_DK_CANDIDATE_POOL_MULTIPLIER=5

# -----------------------------------------------------------------------------
# Domain events (importer / optional HTTP fan-out)
# -----------------------------------------------------------------------------

# noop | log | http (default noop).
# NASCAR_DOMAIN_EVENTS_BACKEND=noop
# NASCAR_DOMAIN_EVENTS_HTTP_URL=
# NASCAR_DOMAIN_EVENTS_HTTP_BEARER=
# NASCAR_DOMAIN_EVENTS_HTTP_HMAC_SECRET=
# NASCAR_DOMAIN_EVENTS_HTTP_TIMEOUT_SECONDS=10
# NASCAR_DOMAIN_EVENTS_HTTP_RAISE_ON_ERROR=0

# -----------------------------------------------------------------------------
# Host scripts and tests (not used by running DAG containers unless passed through)
# -----------------------------------------------------------------------------

# ./script/db-reset-agg — truncates agg_* and ml_* via stored procedures (destructive).

# ./script/test unit-tests image tag.
# UNIT_TESTS_IMAGE=fantasy-sports-airflow-unit-tests:latest

# Integration / regression DB (host pytest).
# AIRFLOW_CONN_NASCAR_CONN=mysql://username:password@127.0.0.1:3306/nascar
# SCRAPER_DATA_ROOT=./scraper-data-regression
# REGRESSION_COMPOSE_PROJECT_NAME=regression-fantasy-sports-airflow
# REGRESSION_DATABASE_PORT=3307

# Debug time parsing in CSV converters (dev).
# CURSOR_DEBUG_TIME=0
