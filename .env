AIRFLOW_UID=1000
AIRFLOW__CORE__LOAD_EXAMPLES=False

# Register backfill.* Cup DAGs in the Airflow UI (1/true/yes/on). Default off.
FS_ENABLE_BACKFILL_DAGS=0

# Scheduling and container OS time (all Airflow services use UTC by default in compose).
AIRFLOW__CORE__DEFAULT_TIMEZONE=utc
TZ=UTC

FS_ML_XGB_DEVICE=cuda

# Run cohort training in-process inside the Celery worker. Set to 0
# because stdlib multiprocessing's Process.start() fails the
# ``daemonic processes are not allowed to have children`` assertion
# under Celery's prefork worker; the in-process branch avoids the
# subprocess path entirely. Flip back to 1 once billiard + fork
# isolation is in place and the worker image picks it up.
FS_ML_TRAIN_COHORT_ISOLATION=0

# Draws per driver per Monte Carlo batch (default 10000, hard minimum 1000).
# Lowering to 1000-2000 trades portfolio percentile fidelity for ~10x faster
# MC + lineup runs and is useful for backfills or developer loops.
FS_MC_N_SIMULATIONS=50000


# -----------------------------------------------------------------------------
# nascar.cup.dfs.lineup_generator
# -----------------------------------------------------------------------------

FS_DK_LINEUP_SIZE=6
FS_DK_SALARY_CAP=50000
FS_DK_TOP_K=10

# Portfolio selection (per DraftKings strategy). Objective metrics are
# computed against the joint MC draw matrix so they capture rank-coupling
# between drivers in the same simulation iteration. Valid objective
# tokens: joint_p10, joint_p50, joint_p90, joint_mean, joint_sharpe.
#
# Write-time exposure defaults are strategy-specific
# (DOUBLE_UP=0.70, HIGH_RISK_REWARD=0.40); read-time diversification
# is applied by the `nascar.dfs_lineups` stored procedure (see
# docs/nascar/cup.dfs.lineup_generator.md).
#
# Monte Carlo summary column used to ORDER the CP-SAT candidate pool. The
# final per-lineup objective is set per strategy via the JOINT metrics
# below; this knob only influences which lineups make the candidate pool.
# Valid values: mean, p05, p50, p95, min, max (default p50).
FS_DK_MC_OBJECTIVE=p50

# Portfolio selection (per DraftKings strategy). Objective metrics are
# computed against the joint MC draw matrix so they capture rank-coupling
# between drivers in the same simulation iteration. Valid objective
# tokens: joint_p10, joint_p50, joint_p90, joint_mean, joint_sharpe.
#
# Write-time exposure defaults are strategy-specific
# (DOUBLE_UP=0.70, HIGH_RISK_REWARD=0.40); read-time diversification
# is applied by the `nascar.dfs_lineups` stored procedure (see
# docs/nascar/cup.dfs.lineup_generator.md).
#
# DOUBLE_UP (cash / 50-50): high-floor objective.
FS_DK_DOUBLE_UP_OBJECTIVE=joint_p10
FS_DK_DOUBLE_UP_EXPOSURE_CAP=0.25
#
# HIGH_RISK_REWARD (GPP / tournament): high-ceiling objective.
FS_DK_HIGH_RISK_REWARD_OBJECTIVE=joint_p90
FS_DK_HIGH_RISK_REWARD_EXPOSURE_CAP=0.30

# Submission portfolio (Python: submission_portfolio.select_portfolio_for_submission)
# Used when picking n=5-15 lineups to enter; tighter than write-time pool caps.
#
# Double Up: maximize count of lineups beating ~top-45% synthetic field cutoff.
FS_DK_SUBMIT_DOUBLE_UP_EXPOSURE_CAP=0.25
FS_DK_SUBMIT_DOUBLE_UP_MIN_DIFF=3
FS_DK_DOUBLE_UP_FIELD_CASH_PERCENTILE=0.55
FS_DK_DOUBLE_UP_MAX_LINEUP_CORR=0.85
FS_DK_DOUBLE_UP_DNF_CAP_WEIGHT=0.5
#
# High Risk Reward (GPP min-cash): higher field bar, looser exposure, ceiling bonus.
FS_DK_SUBMIT_HIGH_RISK_REWARD_EXPOSURE_CAP=0.35
FS_DK_SUBMIT_HIGH_RISK_REWARD_MIN_DIFF=2
FS_DK_HIGH_RISK_REWARD_FIELD_CASH_PERCENTILE=0.82
FS_DK_HIGH_RISK_REWARD_MAX_LINEUP_CORR=0.90
FS_DK_HIGH_RISK_REWARD_CEILING_WEIGHT=0.15
#
# Synthetic field samples for cash cutoff estimation (field_cutoff.py).
# FS_DK_FIELD_SAMPLE_COUNT=500
#
# Candidate pool (shared CP-SAT + random feasible union per race).
FS_DK_CANDIDATE_POOL_MULTIPLIER=100
FS_DK_RANDOM_POOL_MULTIPLIER=20
FS_DK_WRITE_MIN_DIFF_DOUBLE_UP=3
FS_DK_WRITE_MIN_DIFF_HIGH_RISK_REWARD=2