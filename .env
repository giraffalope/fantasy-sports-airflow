AIRFLOW_UID=1000
AIRFLOW__CORE__LOAD_EXAMPLES=False

# Register backfill.* Cup DAGs in the Airflow UI (1/true/yes/on). Default off.
FS_ENABLE_BACKFILL_DAGS=0

# Scheduling and container OS time (all Airflow services use UTC by default in compose).
AIRFLOW__CORE__DEFAULT_TIMEZONE=utc
TZ=UTC

FS_ML_XGB_DEVICE=cuda

# Run cohort training in-process inside the Celery worker. Set to 0
# because stdlib multiprocessing's Process.start() fails the
# ``daemonic processes are not allowed to have children`` assertion
# under Celery's prefork worker; the in-process branch avoids the
# subprocess path entirely. Flip back to 1 once billiard + fork
# isolation is in place and the worker image picks it up.
FS_ML_TRAIN_COHORT_ISOLATION=0